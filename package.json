{
  "name": "obsidian-office-viewer-plugin",
  "version": "0.2.5",
  "description": "Read local PPTX and DOCX files in Obsidian, with document search and presentation references.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "fixtures:failure": "node scripts/generate-failure-fixtures.mjs",
    "fixtures:failure:regenerate": "node scripts/generate-failure-fixtures.mjs --force",
    "fixtures:compatibility": "node scripts/generate-compatibility-fixtures.mjs",
    "fixtures:compatibility:regenerate": "node scripts/generate-compatibility-fixtures.mjs --force",
    "fixtures:performance": "node scripts/generate-performance-fixtures.mjs",
    "fixtures:performance:regenerate": "node scripts/generate-performance-fixtures.mjs --force",
    "fixtures": "node scripts/generate-minimal-fixture.mjs",
    "fixtures:regenerate": "node scripts/generate-minimal-fixture.mjs --force",
    "fixtures:speaker-notes": "node scripts/generate-speaker-notes-fixture.mjs",
    "fixtures:speaker-notes:regenerate": "node scripts/generate-speaker-notes-fixture.mjs --force",
    "fixtures:docx": "node scripts/generate-docx-exploration-fixtures.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "build:dev": "npm run typecheck && node esbuild.config.mjs production dev && node scripts/package-dev.mjs",
    "build:aiden": "node scripts/run-renderer-candidate.mjs aiden build",
    "build:pptx-preview": "node scripts/run-renderer-candidate.mjs pptx-preview build",
    "test": "npm run build && vitest run --exclude tests/performance/performance-baseline.test.ts",
    "test:compatibility": "npm run fixtures:compatibility && npm run build && wdio run wdio.compatibility.conf.mts",
    "test:compatibility:docx": "npm run fixtures:docx && npm run build && wdio run wdio.docx-compatibility.conf.mts",
    "test:compatibility:aiden": "node scripts/run-renderer-candidate.mjs aiden test:compatibility",
    "test:compatibility:pptx-preview": "node scripts/run-renderer-candidate.mjs pptx-preview test:compatibility",
    "test:e2e": "npm run fixtures:failure && npm run build && wdio run wdio.conf.mts && node scripts/run-degraded-e2e.mjs && npm run test:e2e:multilingual",
    "test:e2e:docx": "npm run fixtures:docx && npm run build && wdio run wdio.docx.conf.mts",
    "test:e2e:live-preview:min": "npm run fixtures:failure && npm run build && wdio run wdio.live-preview-min.conf.mts",
    "test:e2e:multilingual": "npm run fixtures:speaker-notes && npm run build && wdio run wdio.multilingual.conf.mts",
    "test:e2e:aiden": "node scripts/run-renderer-candidate.mjs aiden test:e2e",
    "test:e2e:pptx-preview": "node scripts/run-renderer-candidate.mjs pptx-preview test:e2e",
    "test:performance": "npm run fixtures:performance && npm run build && wdio run wdio.performance.conf.mts",
    "test:performance:docx": "npm run fixtures:docx && npm run build && wdio run wdio.docx-performance.conf.mts",
    "test:performance:aiden": "node scripts/run-renderer-candidate.mjs aiden test:performance",
    "test:performance:pptx-preview": "node scripts/run-renderer-candidate.mjs pptx-preview test:performance",
    "test:performance:baseline": "npm run build && vitest run tests/performance/performance-baseline.test.ts tests/performance/performance-run-provenance.test.ts",
    "test:performance:baseline:aiden": "node scripts/run-renderer-candidate.mjs aiden test:performance:baseline",
    "test:performance:baseline:pptx-preview": "node scripts/run-renderer-candidate.mjs pptx-preview test:performance:baseline",
    "release:check": "node scripts/check-release.mjs",
    "release:check:publish": "node scripts/run-check-publish-release.mjs",
    "release:package": "npm run build && node scripts/package-release.mjs",
    "test:release": "npm run release:package && node scripts/prepare-release-test.mjs && wdio run wdio.release.conf.mts",
    "verify": "npm run fixtures && npm run fixtures:speaker-notes && npm run fixtures:compatibility && npm run fixtures:performance && npm run fixtures:failure && npm run fixtures:docx && npm test"
  },
  "keywords": [
    "obsidian",
    "pptx",
    "powerpoint",
    "docx",
    "word",
    "viewer"
  ],
  "author": "Jerry Pan",
  "license": "MIT",
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.2.4",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "cfb": "1.2.2",
    "docx-preview": "0.3.6",
    "jszip": "3.10.1",
    "wmf": "1.0.2"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/language": "6.12.4",
    "@types/mocha": "10.0.10",
    "@types/node": "24.0.10",
    "@types/pngjs": "^6.0.5",
    "@wdio/cli": "9.29.1",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "9.29.1",
    "canvas": "3.1.0",
    "esbuild": "0.28.1",
    "jsdom": "^29.1.1",
    "mocha": "11.7.4",
    "obsidian": "1.13.1",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "pptx-preview": "1.0.7",
    "pptxgenjs": "4.0.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wdio-obsidian-reporter": "3.1.1",
    "wdio-obsidian-service": "3.1.1"
  },
  "overrides": {
    "brace-expansion": "2.1.3",
    "echarts": "6.1.0",
    "mocha": {
      "diff": "8.0.3",
      "serialize-javascript": "7.0.5"
    },
    "tar": "7.5.22",
    "uuid": "11.1.1"
  }
}
